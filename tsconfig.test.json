{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    // `vite/client` is here for the one thing it declares that these tests
    // need: `import.meta.env`. terms-acceptance.test.ts imports the legal
    // config — the source of truth for the Terms version — and that reaches
    // src/lib/config/env.ts, which reads the Vite environment.
    "types": ["node", "vitest/globals", "vite/client"],
    "lib": ["ES2023", "DOM"],
    // The Edge Function sources are Deno modules: they import with an explicit
    // .ts extension because Deno requires it. The suite type-checks them along
    // with everything else rather than leaving the one place a credential lives
    // outside the type system.
    "allowImportingTsExtensions": true,

    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "supabase/tests",
    "supabase/functions/tests",
    "supabase/functions/_shared",
    "src/**/*.node.test.ts"
  ]
}
