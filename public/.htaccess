# Apache / LiteSpeed configuration for the built application.
#
# Hostinger serves the contents of `dist/` as static files. This file is copied
# there verbatim by the Vite build (everything in `public/` is).

# ---------------------------------------------------------------------------
# Single-page application routing
#
# Without this, a refresh on /settings asks the server for a file that does not
# exist and returns 404. Every path that is not a real file is handed to
# index.html so the client router can resolve it.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # The Help Centre's front page, before the passthrough below can claim it.
  #
  # /help is an application route, but public/help/ also holds the Help Centre
  # screenshots, so the deployed site has a real directory of that name. Left to
  # the rules below, mod_dir redirected /help to /help/ (301), the -d condition
  # then handed it to the directory, there is no index.html inside one, and the
  # front page answered 403 in production while every test passed locally —
  # the dev server has no such directory to collide with.
  #
  # Article pages were never affected: /help/rentals is neither a file nor a
  # directory. The screenshots are not affected either; /help/vehicles-01.jpg is
  # a real file and still matches -f below. This rule is exact, so it catches
  # only the index itself.
  RewriteRule ^help/?$ index.html [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# Caching
#
# Vite fingerprints asset filenames, so they can be cached indefinitely.
# index.html must never be cached, or a deploy would not reach returning users.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<FilesMatch "\.(js|css|woff2|svg|webp|png|jpg)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

<FilesMatch "index\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Never serve environment files, even if one is uploaded by mistake.
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
